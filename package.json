{
  "name": "obsidian-outlook-drop",
  "version": "0.10.0",
  "private": true,
  "description": "Import Apple Mail and Outlook .eml drops into an Obsidian vault.",
  "scripts": {
    "test": "vitest run",
    "build": "node scripts/build.mjs",
    "package": "python3 scripts/package-release.py",
    "lint": "eslint src --max-warnings 0",
    "verify": "npm run lint && npm test && npm run build && npm run build:native && node scripts/review-checks.mjs",
    "build:native": "node scripts/build-native.mjs"
  },
  "devDependencies": {
    "@eslint/json": "^0.14.0",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "html-to-text": "^10.0.1",
    "obsidian": "^1.14.4",
    "postal-mime": "^2.4.4",
    "typescript": "^5.7.2",
    "vitest": "^4.1.12"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/viggomeesters/obsidian-mail-drop.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "moment": "^2.31.0"
  }
}
